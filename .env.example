# Admin app environment
EXPO_PUBLIC_API_URL=https://rider-booking-app.onrender.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-a-restricted-key
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-your-eas-project-id
# Temporary only: turn false after the backend login route is correctly secured.
EXPO_PUBLIC_ALLOW_DEV_JWT_LOGIN=true

# Never store RAZORPAY_KEY_SECRET in the mobile app or an EXPO_PUBLIC_* variable.
# Order creation and signature verification must run on the trusted backend.
